{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@shared/*": ["./src/shared/*"],
      "@enso/pair": ["./packages/pair/src/index.ts"],
      "@vetta-org/plugin-sdk": ["./src/renderer/features/design/host/sdk.ts"],
      "@design-engine/*": ["./resources/design/engine/*"],
      "@design-agent/*": ["./resources/design/*"]
    }
  },
  "include": ["src/**/*", "packages/pair/src/**/*", "electron.vite.config.ts"]
}
